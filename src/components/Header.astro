---
import { NAV, PERSON } from '../data/profile';
import Signature from './Signature.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label={`${PERSON.name} — home`}>
      <Signature width="3.6rem" class="brand__sig" />
      <span class="brand__name">{PERSON.name}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list list-plain">
        {
          NAV.map((item) => (
            <li>
              <a
                class:list={['nav__link', isActive(item.href) && 'is-active']}
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.85rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    /* Comfortable target without inflating the header. */
    min-block-size: 44px;
  }

  .brand__sig {
    flex: none;
    transition: opacity 0.3s var(--ease);
  }

  .brand:hover .brand__sig,
  .brand:focus-visible .brand__sig {
    opacity: 0.75;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: 0.01em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: 0.7rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.25s var(--ease);
  }

  .nav__link:hover,
  .nav__link:focus-visible {
    color: var(--parchment);
  }

  .nav__link.is-active {
    color: var(--brass);
  }

  /* Narrow phones: brand on its own line, nav beneath it, still no hamburger. */
  @media (max-width: 30rem) {
    .site-header__inner {
      justify-content: center;
    }

    .brand__name {
      font-size: var(--step-0);
    }

    .nav {
      inline-size: 100%;
      justify-content: space-between;
    }

    .nav__link {
      padding-inline: 0.5rem;
      letter-spacing: 0.08em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__link,
    .brand__sig {
      transition: none;
    }
  }
</style>
