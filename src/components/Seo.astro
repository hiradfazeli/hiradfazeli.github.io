---
import { PERSON, SITE } from '../data/profile';

export interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative image path. Defaults to the shared OG card. */
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  /** JSON-LD nodes to place inside the @graph for this page. */
  schema?: unknown[];
}

const { title, description, image = SITE.ogImage, type = 'website', noindex = false, schema = [] } =
  Astro.props;

// Canonical is derived from the configured site + the current path, so it can
// never drift from where the page actually lives.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const graph = schema.length ? { '@context': 'https://schema.org', '@graph': schema } : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex && <meta name="robots" content="noindex, follow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

<meta name="author" content={PERSON.name} />

{/* Open Graph */}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={PERSON.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${PERSON.name} — ${PERSON.headline}`} />
<meta property="og:locale" content="en_US" />

{/* Twitter / X */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
  graph && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(graph)}
    />
  )
}
