---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Guilloche from '../../components/Guilloche.astro';
import { breadcrumbNode, organizationNode, personRef } from '../../lib/schema';

// The product is introduced commercially: what it does for the people using it,
// who it is for, and what running it involves. Implementation detail is
// deliberately left out.
const features = [
  {
    name: 'A live map',
    detail:
      'Go online and see who is actually out nearby right now, rather than guessing. That single view is the whole product — everything else grows out of it.',
  },
  {
    name: 'Walks & playdates',
    detail:
      'Plan a walk and invite the neighbourhood, or join one already happening. Owners meet in person; the app exists to get them there and then get out of the way.',
  },
  {
    name: 'Packs',
    detail:
      'People who keep meeting quietly form a pack — the regular group you walk with. It is the retention loop and the point of the whole thing at once.',
  },
  {
    name: 'Lost-pet alerts',
    detail:
      'Raise an alert and reach the people physically closest to your missing pet within seconds. Nothing else in the category does this well, and it is the feature people tell their friends about.',
  },
  {
    name: 'Profiles & chat',
    detail:
      'Every owner and every pet has a profile, so you know who and which dog you are meeting before you go. Messaging is built in.',
  },
  {
    name: 'Free at the core',
    detail:
      'The map, chat and safety features are free and stay free. Revenue comes from local pet businesses appearing on the map, not from charging owners to meet each other.',
  },
];

const founderWork = [
  {
    q: 'The product',
    a: 'Every screen, every flow and every word of the interface — in every language it ships in. When something feels wrong, there is nobody else to escalate it to.',
  },
  {
    q: 'Shipping it',
    a: 'Deciding what ships and when, getting releases out, and keeping the thing running afterwards. One person, one release cycle, no handoffs.',
  },
  {
    q: 'Going to market',
    a: 'Positioning, store presence, pricing and launch — then growing it neighbourhood by neighbourhood, because that is the unit a map product actually becomes useful in.',
  },
  {
    q: 'Partnerships',
    a: 'Vets, groomers, pet shops and dog-friendly places who want to be found by exactly the people already walking past them. That is the revenue side, and I sell it myself.',
  },
  {
    q: 'Trust and safety',
    a: 'A product built on location and strangers meeting has to earn trust before anything else. It is explicitly not a dating app, and that boundary shaped the design throughout.',
  },
];

const schema = [
  organizationNode,
  breadcrumbNode([
    { name: 'Home', url: '/' },
    { name: 'Work', url: '/work/' },
    { name: 'ZEEberton', url: '/work/zeeberton/' },
  ]),
  {
    '@type': 'SoftwareApplication',
    name: 'ZEEberton',
    url: 'https://zeeberton.com',
    applicationCategory: 'SocialNetworkingApplication',
    operatingSystem: 'Android',
    description:
      'A map-first social network that puts dog and cat owners on a live map so they can plan walks and playdates, form packs, and catch lost-pet alerts nearby.',
    author: personRef,
    creator: personRef,
    publisher: { '@id': 'https://zeeberton.com/#organization' },
    // `inLanguage` intentionally omitted: an incomplete list would signal to search
    // engines that the app serves only those locales, which is the opposite of the
    // point. Add it back once the full shipped locale list is confirmed.
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
];
---

<BaseLayout
  title="ZEEberton — A Live Map for Pet Owners | Hirad Fazeli"
  description="ZEEberton puts dog and cat owners on a live map to plan walks, form packs and catch lost-pet alerts nearby. Founded and run solo by Hirad Fazeli."
  type="article"
  schema={schema}
>
  <section class="hero">
    <Guilloche cx={0.85} scale={0.72} />
    <div class="wrap hero__inner">
      <nav class="crumbs mono" aria-label="Breadcrumb">
        <a class="u" href="/work/">Work</a> <span aria-hidden="true">/</span>
        <span aria-current="page">ZEEberton</span>
      </nav>

      <h1 class="hero__title">ZEEberton</h1>
      <p class="hero__sub">A live map for pet owners — founded and run solo.</p>

      <dl class="meta">
        <div class="meta__item">
          <dt class="label">Role</dt>
          <dd>Founder</dd>
        </div>
        <div class="meta__item">
          <dt class="label">Period</dt>
          <dd>May 2026 &mdash; present</dd>
        </div>
        <div class="meta__item">
          <dt class="label">Scope</dt>
          <dd>Product, launch, partnerships</dd>
        </div>
        <div class="meta__item">
          <dt class="label">Live at</dt>
          <dd><a class="u" href="https://zeeberton.com" target="_blank" rel="noopener">zeeberton.com &nearr;</a></dd>
        </div>
      </dl>
    </div>
  </section>

  {/* ----------------------------------------------------------------- problem */}
  <section class="section wrap" aria-labelledby="problem">
    <div class="section-head">
      <h2 id="problem">The problem</h2>
      <p class="label">01</p>
    </div>

    <div class="prose stack reveal">
      <p>
        Owning a dog is a deeply social activity attached to a stubbornly unsocial
        problem: the people you most want to meet are the ones already walking past your
        door, and you have no way of knowing who they are. Existing pet apps solved
        adjacent things — vet records, marketplaces, breed forums — but none of them
        answered the only question that matters at 8pm on a Tuesday: <em>who is out
        right now, near me, with a dog mine would get along with?</em>
      </p>
      <p>
        ZEEberton answers exactly that. Go online, see live pins of nearby owners, look
        at their profile, connect, chat, and meet in person. Repeat meetups quietly form
        <em>packs</em>. It is explicitly not a dating app, and that boundary shaped a
        great deal of the design.
      </p>
    </div>
  </section>

  {/* -------------------------------------------------------------- the product */}
  <section class="section wrap" aria-labelledby="product">
    <div class="section-head">
      <h2 id="product">What it does</h2>
      <p class="label">02</p>
    </div>

    <p class="lede arch__lede reveal">
      One idea, carried through properly: show people who is nearby, and make meeting
      them easy.
    </p>

    <ol class="arch list-plain">
      {
        features.map((feature, i) => (
          <li class="arch__row reveal" data-delay={Math.min(i, 3) || undefined}>
            <p class="arch__tier mono">{String(i + 1).padStart(2, '0')}</p>
            <div class="arch__body">
              <h3 class="arch__name">{feature.name}</h3>
              <p class="arch__detail">{feature.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ----------------------------------------------------------------- market */}
  <section class="section wrap" aria-labelledby="market">
    <div class="section-head">
      <h2 id="market">Who it is for</h2>
      <p class="label">03</p>
    </div>

    <div class="prose stack reveal">
      <p>
        Dog and cat owners, anywhere. The map works wherever you open it, and the app
        ships in multiple languages — there is no country gate and no waiting list for
        your city.
      </p>
      <p>
        What a map product does have is a density effect: it gets useful the moment
        enough people near <em>you</em> are on it. So it grows neighbourhood by
        neighbourhood rather than territory by territory — the same way the walk outside
        your door does. Reach without anyone on your street is worth nothing; a handful
        of owners in your park is worth a great deal.
      </p>
      <p>
        That is a growth pattern, not a boundary. Every new neighbourhood that reaches
        critical mass works exactly like the last one, wherever it happens to be.
      </p>
    </div>
  </section>

  {/* ----------------------------------------------------------- founder scope */}
  <section class="section wrap" aria-labelledby="scope">
    <div class="section-head">
      <h2 id="scope">What running it involves</h2>
      <p class="label">04</p>
    </div>

    <div class="decisions">
      {
        founderWork.map((d, i) => (
          <article class="decision reveal" data-delay={Math.min(i, 3) || undefined}>
            <h3 class="decision__q">{d.q}</h3>
            <p class="decision__a">{d.a}</p>
          </article>
        ))
      }
    </div>
  </section>

  {/* ------------------------------------------------------------------- where */}
  <section class="section wrap" aria-labelledby="status">
    <div class="section-head">
      <h2 id="status">Where it stands</h2>
      <p class="label">05</p>
    </div>

    <div class="prose stack reveal">
      <p>
        The Android app is on Google Play in closed testing, localised into multiple
        languages and open to owners wherever they are. iOS is deliberately deferred
        until the Android product has earned it.
      </p>
      <p>
        The interesting part has been the range rather than any single piece. The same
        week can involve a design decision, a release, an app-store policy review, and a
        conversation with a vet clinic about what a pin on the map is worth to them.
      </p>
      <p class="no-print">
        <a class="btn" href="https://zeeberton.com" target="_blank" rel="noopener">
          Visit zeeberton.com &nearr;
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(2.5rem, 2rem + 6vw, 6rem);
    border-bottom: 1px solid var(--rule);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .hero__title {
    font-size: var(--step-5);
    line-height: 0.95;
  }

  .hero__sub {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--brass);
    margin-top: 0.75rem;
    max-width: 22ch;
    text-wrap: balance;
  }

  .meta {
    display: grid;
    gap: 1.5rem clamp(1.5rem, 1rem + 3vw, 3rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    margin-top: clamp(2rem, 1.5rem + 3vw, 3.5rem);
    padding-top: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border-top: 1px solid var(--rule);
  }

  .meta__item dt {
    margin-bottom: 0.4rem;
  }

  .meta__item dd {
    margin: 0;
    font-size: var(--step--1);
  }

  /* --------------------------------------------------------------- structure */
  .arch__lede {
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .arch__row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding-block: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border-top: 1px solid var(--rule);
  }

  .arch__tier {
    color: var(--brass);
    padding-top: 0.4em;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .arch__name {
    font-size: var(--step-1);
    margin-bottom: 0.5rem;
  }

  .arch__detail {
    color: var(--muted);
    max-width: var(--measure);
  }

  /* --------------------------------------------------------------- decisions */
  .decisions {
    display: grid;
    gap: clamp(1.75rem, 1rem + 3vw, 3rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .decision__q {
    font-size: var(--step-1);
    color: var(--brass);
    padding-bottom: 0.75rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  .decision__a {
    color: var(--muted);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-block-size: 48px;
    padding-inline: 1.4rem;
    margin-top: 1rem;
    border: 1px solid var(--brass);
    color: var(--brass);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  .btn:hover,
  .btn:focus-visible {
    background: var(--brass);
    color: var(--ink);
  }

  @media (max-width: 36rem) {
    .arch__row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .arch__tier {
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
  }
</style>
